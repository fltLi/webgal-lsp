# This file is generated by AI.

# 由 add_custom_command 以 `cmake -P` 调用: 把 assets/ 下的二进制素材 (目前是 SMAA 的
# area/search LUT) 转成 C++ 源文件, 渲染器运行时不需要额外的资源文件。
#
# 与 embed-shaders.cmake 是同一套思路, 只是不做 glslc 编译: 素材原样内嵌成字节数组,
# 运行时按名字取出来解码 (见 src/assets/embedded_assets.hpp)。
#
# 参数:
#   -DASSET_DIR=<目录>    素材所在目录 (按文件名排序)
#   -DOUTPUT_CPP=<文件>   生成的 .cpp 路径

foreach(required IN ITEMS ASSET_DIR OUTPUT_CPP)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "embed-assets.cmake 缺少 -D${required}")
    endif()
endforeach()

file(GLOB asset_files "${ASSET_DIR}/*")
if(NOT asset_files)
    message(FATAL_ERROR "没有找到素材: ${ASSET_DIR}/*")
endif()
list(SORT asset_files)

get_filename_component(output_dir "${OUTPUT_CPP}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")

set(array_declarations "")
set(table_entries "")
set(known_names "")
set(array_count 0)

foreach(asset_path IN LISTS asset_files)
    get_filename_component(file_name "${asset_path}" NAME)

    # 文件名里的非字母数字一律换成下划线, 保证能当 C++ 标识符。
    string(MAKE_C_IDENTIFIER "${file_name}" symbol_suffix)

    file(READ "${asset_path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR byte_count "${hex_length} / 2")
    if(byte_count EQUAL 0)
        message(FATAL_ERROR "素材为空: ${asset_path}")
    endif()

    # 每行 16 字节, 与 embed-shaders.cmake 一致; 生成物不参与 clang-format。
    set(literals "")
    set(current_line "")
    set(index 0)
    while(index LESS byte_count)
        math(EXPR offset "${index} * 2")
        string(SUBSTRING "${hex}" ${offset} 2 pair)
        string(APPEND current_line "0x${pair}, ")
        math(EXPR index "${index} + 1")
        math(EXPR column "${index} % 16")
        if(column EQUAL 0)
            string(APPEND literals "    ${current_line}\n")
            set(current_line "")
        endif()
    endwhile()
    if(NOT current_line STREQUAL "")
        string(APPEND literals "    ${current_line}\n")
    endif()

    string(APPEND array_declarations "const std::uint8_t kAsset${symbol_suffix}[] = {\n${literals}};\n\n")
    string(APPEND table_entries "    {\"${file_name}\", kAsset${symbol_suffix}, sizeof(kAsset${symbol_suffix})},\n")
    string(APPEND known_names "${file_name} ")
    math(EXPR array_count "${array_count} + 1")
endforeach()

string(CONCAT generated
    "// This file is generated by AI.\n"
    "\n"
    "// 由 native/webgal-video-render/cmake/embed-assets.cmake 在构建期生成, 不要手工编辑。\n"
    "// 内嵌素材: ${known_names}\n"
    "\n"
    "#include <array>\n"
    "#include <cstring>\n"
    "\n"
    "#include \"assets/embedded_assets.hpp\"\n"
    "\n"
    "namespace webgal::assets {\n"
    "namespace {\n"
    "\n"
    "${array_declarations}"
    "const std::array<EmbeddedAsset, ${array_count}> kTable = {{\n"
    "${table_entries}"
    "}};\n"
    "\n"
    "} // namespace\n"
    "\n"
    "const EmbeddedAsset* find(const char* name) {\n"
    "    for (const auto& asset : kTable) {\n"
    "        if (std::strcmp(asset.name, name) == 0) {\n"
    "            return &asset;\n"
    "        }\n"
    "    }\n"
    "    return nullptr;\n"
    "}\n"
    "\n"
    "} // namespace webgal::assets\n"
)

# 只在内容变化时重写, 避免无谓地重编译引用它的目标。
set(existing "")
if(EXISTS "${OUTPUT_CPP}")
    file(READ "${OUTPUT_CPP}" existing)
endif()
if(NOT existing STREQUAL generated)
    file(WRITE "${OUTPUT_CPP}" "${generated}")
endif()
