# This file is generated by AI.

# 由 add_custom_command 以 `cmake -P` 调用: 把 glslc 产出的 .spv 字节码
# 转成 C++ 源文件, 使渲染器不再在运行时读取 shader 文件。
#
# 这是渲染器专属的构建步骤, 因此跟子项目放在一起; 根 cmake/ 只放 workspace 级工具。
#
# 参数:
#   -DSPV_DIR=<目录>     编译后的 .spv 所在目录 (按文件名排序)
#   -DOUTPUT_CPP=<文件>  生成的 .cpp 路径

foreach(required IN ITEMS SPV_DIR OUTPUT_CPP)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "embed-shaders.cmake 缺少 -D${required}")
    endif()
endforeach()

file(GLOB spv_files "${SPV_DIR}/*.spv")
if(NOT spv_files)
    message(FATAL_ERROR "没有找到 shader 字节码: ${SPV_DIR}/*.spv")
endif()
list(SORT spv_files)

get_filename_component(output_dir "${OUTPUT_CPP}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")

set(array_declarations "")
set(table_entries "")
set(known_names "")
set(array_count 0)

foreach(spv_path IN LISTS spv_files)
    get_filename_component(file_name "${spv_path}" NAME)
    string(REGEX REPLACE "\\.spv$" "" shader "${file_name}")

    string(REPLACE "." ";" parts "${shader}")
    list(GET parts 0 base)
    list(GET parts 1 stage)

    string(SUBSTRING "${base}" 0 1 first_letter)
    string(TOUPPER "${first_letter}" first_letter)
    string(SUBSTRING "${base}" 1 -1 rest)
    string(TOLOWER "${stage}" stage_lower)
    string(SUBSTRING "${stage_lower}" 0 1 stage_letter)
    string(TOUPPER "${stage_letter}" stage_letter)
    string(SUBSTRING "${stage_lower}" 1 -1 stage_rest)
    set(symbol "k${first_letter}${rest}${stage_letter}${stage_rest}")

    file(READ "${spv_path}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR byte_count "${hex_length} / 2")
    if(byte_count EQUAL 0)
        message(FATAL_ERROR "shader 字节码为空: ${spv_path}")
    endif()

    # 每行 16 字节, 便于审阅 diff; 生成物不参与 clang-format.
    set(literals "")
    set(current_line "")
    set(index 0)
    while(index LESS byte_count)
        math(EXPR offset "${index} * 2")
        string(SUBSTRING "${hex}" ${offset} 2 pair)
        string(APPEND current_line "0x${pair}, ")
        math(EXPR index "${index} + 1")
        math(EXPR column "${index} % 16")
        if(column EQUAL 0)
            string(APPEND literals "    ${current_line}\n")
            set(current_line "")
        endif()
    endwhile()
    if(NOT current_line STREQUAL "")
        string(APPEND literals "    ${current_line}\n")
    endif()

    string(APPEND array_declarations "const std::uint8_t ${symbol}[] = {\n${literals}};\n\n")
    string(APPEND table_entries "    {\"${shader}\", ${symbol}, sizeof(${symbol})},\n")
    string(APPEND known_names "${shader} ")
    math(EXPR array_count "${array_count} + 1")
endforeach()

string(CONCAT generated
    "// This file is generated by AI.\n"
    "\n"
    "// 由 native/webgal-video-render/cmake/embed-shaders.cmake 在构建期生成, 不要手工编辑。\n"
    "// 内嵌 shader: ${known_names}\n"
    "\n"
    "#include <array>\n"
    "\n"
    "#include \"shaders/embedded_shaders.hpp\"\n"
    "\n"
    "namespace webgal::shaders {\n"
    "namespace {\n"
    "\n"
    "${array_declarations}"
    "const std::array<EmbeddedShader, ${array_count}> kTable = {{\n"
    "${table_entries}"
    "}};\n"
    "\n"
    "} // namespace\n"
    "\n"
    "const EmbeddedShader* shaders() {\n"
    "    return kTable.data();\n"
    "}\n"
    "\n"
    "std::size_t count() {\n"
    "    return kTable.size();\n"
    "}\n"
    "\n"
    "} // namespace webgal::shaders\n"
)

# 只在内容变化时重写, 避免无谓地重编译引用它的目标.
set(existing "")
if(EXISTS "${OUTPUT_CPP}")
    file(READ "${OUTPUT_CPP}" existing)
endif()
if(NOT existing STREQUAL generated)
    file(WRITE "${OUTPUT_CPP}" "${generated}")
endif()
