// This file is generated by AI.

#version 450

layout(set = 0, binding = 0) uniform sampler2D in_texture;
layout(set = 0, binding = 1) uniform sampler2D in_mask;

layout(push_constant) uniform PushConstants {
    vec4 tint;
    vec4 adjust;
    vec4 fx;
    vec4 mask;
    vec4 mask_transform;
    vec4 multiply;
    vec4 screen;
    vec4 shape;
} pc;

layout(location = 0) in vec2 v_uv;
layout(location = 1) in vec2 v_mask_uv;
layout(location = 0) out vec4 out_color;

vec4 sample_blurred(vec2 uv, float radius) {
    vec2 texel = 1.0 / vec2(textureSize(in_texture, 0));
    vec4 color = texture(in_texture, uv);
    float weight = 1.0;
    for (int x = -2; x <= 2; ++x) {
        for (int y = -2; y <= 2; ++y) {
            if (x == 0 && y == 0) {
                continue;
            }
            float w = 1.0 / (1.0 + float(x * x + y * y));
            color += texture(in_texture, uv + vec2(x, y) * texel * radius) * w;
            weight += w;
        }
    }
    return color / weight;
}

/// 紧凑 FXAA: 只在检测到边缘时沿边缘方向混合, 避免把整幅画面糊掉。
vec3 fxaa(sampler2D tex, vec2 uv) {
    vec2 texel = 1.0 / vec2(textureSize(tex, 0));
    vec3 rgb_m = texture(tex, uv).rgb;
    vec3 rgb_nw = texture(tex, uv + vec2(-1.0, -1.0) * texel).rgb;
    vec3 rgb_ne = texture(tex, uv + vec2(1.0, -1.0) * texel).rgb;
    vec3 rgb_sw = texture(tex, uv + vec2(-1.0, 1.0) * texel).rgb;
    vec3 rgb_se = texture(tex, uv + vec2(1.0, 1.0) * texel).rgb;

    vec3 luma = vec3(0.299, 0.587, 0.114);
    float luma_m = dot(rgb_m, luma);
    float luma_nw = dot(rgb_nw, luma);
    float luma_ne = dot(rgb_ne, luma);
    float luma_sw = dot(rgb_sw, luma);
    float luma_se = dot(rgb_se, luma);

    float luma_min = min(luma_m, min(min(luma_nw, luma_ne), min(luma_sw, luma_se)));
    float luma_max = max(luma_m, max(max(luma_nw, luma_ne), max(luma_sw, luma_se)));
    if (luma_max - luma_min < max(0.0312, luma_max * 0.125)) {
        return rgb_m;
    }

    vec2 direction;
    direction.x = -((luma_nw + luma_ne) - (luma_sw + luma_se));
    direction.y = (luma_nw + luma_sw) - (luma_ne + luma_se);
    float reduce = max((luma_nw + luma_ne + luma_sw + luma_se) * (0.25 / 8.0), 1.0 / 128.0);
    float rcp_min = 1.0 / (min(abs(direction.x), abs(direction.y)) + reduce);
    direction = clamp(direction * rcp_min, vec2(-8.0), vec2(8.0)) * texel;

    vec3 rgb_a = 0.5 * (texture(tex, uv + direction * (1.0 / 3.0 - 0.5)).rgb +
                        texture(tex, uv + direction * (2.0 / 3.0 - 0.5)).rgb);
    vec3 rgb_b = rgb_a * 0.5 +
                 0.25 * (texture(tex, uv - direction * 0.5).rgb +
                         texture(tex, uv + direction * 0.5).rgb);
    float luma_b = dot(rgb_b, luma);
    return (luma_b < luma_min || luma_b > luma_max) ? rgb_a : rgb_b;
}

void main() {
    // mode 3: 最终 FXAA 后处理, 输出不透明画面。
    if (pc.mask_transform.w > 2.5) {
        // 只混 65%, 保留文字和背景纹理的锐度; 全量 FXAA 在 720p 上会显得发糊。
        vec3 original = texture(in_texture, v_uv).rgb;
        out_color = vec4(mix(original, fxaa(in_texture, v_uv), 0.5), 1.0);
        return;
    }

    // mode 1: 立绘层合成。输入是预乘 alpha 的整层纹理, 在这里做
    // Pixi BevelFilter 的 light 通道与 AdvancedBloomFilter 的柔光。
    if (pc.mask_transform.w > 0.5 && pc.mask_transform.w < 1.5) {
        vec2 layer_texel = 1.0 / vec2(textureSize(in_texture, 0));
        vec4 sampled = texture(in_texture, v_uv);
        float layer_alpha = sampled.a;
        vec3 base = sampled.rgb / max(layer_alpha, 1.0e-4);

        // 倒角: 当前像素比"朝光源方向偏移 thickness 像素"的邻居更不透明时提亮。
        if (pc.mask.z > 0.001 && pc.mask.w > 0.001) {
            float angle = pc.mask_transform.x;
            vec2 offset = vec2(cos(angle), sin(angle)) * pc.mask.w * layer_texel;
            float neighbor_alpha = texture(in_texture, v_uv - offset).a;
            float factor = clamp((layer_alpha - neighbor_alpha) * pc.mask.z, 0.0, 1.0);
            vec3 light_color = vec3(pc.multiply.w, pc.screen.w, pc.shape.w);
            vec3 lit = vec3(1.0) - (vec3(1.0) - base) * (vec3(1.0) - light_color);
            base = mix(base, lit, factor);
        }

        // 泛光: 在整层上采样亮部并模糊; 透明区域的采样也会贡献颜色,
        // 所以光晕可以扩散到模型轮廓之外。
        vec3 glow = vec3(0.0);
        if (pc.fx.x > 0.001) {
            float radius = max(12.0, pc.fx.y * 8.0);
            // 阈值给一个下限: 引擎默认 threshold 是 0, 但直接对全图做会变成一层白雾;
            // 这里只让真正的高光参与泛光。
            float threshold = max(pc.fx.z, 0.30);
            float total = 0.0;
            for (int ring = 1; ring <= 3; ++ring) {
                float ring_radius = radius * float(ring) / 3.0;
                float weight = ring == 1 ? 0.6 : (ring == 2 ? 0.3 : 0.15);
                for (int index = 0; index < 8; ++index) {
                    float angle = float(index) * 0.7853981634;
                    vec4 sample_color =
                        texture(in_texture, v_uv + vec2(cos(angle), sin(angle)) * ring_radius * layer_texel);
                    float sample_alpha = sample_color.a;
                    vec3 straight = sample_color.rgb / max(sample_alpha, 1.0e-4);
                    float luma = dot(straight, vec3(0.299, 0.587, 0.114));
                    float bright = smoothstep(threshold, threshold + 0.2, luma);
                    glow += straight * bright * sample_alpha * weight;
                    total += weight;
                }
            }
            glow = glow / max(total, 1.0) * pc.fx.x * pc.fx.w * 1.00;
            // 只让光晕落在模型轮廓之外/边缘, 避免把整张立绘提亮成过曝。
            glow *= 1.0 - smoothstep(0.0, 0.75, layer_alpha);
        }

        float a = layer_alpha * pc.tint.a;
        // 基础颜色乘层 alpha; 泛光不再乘中心 alpha, 否则光晕会被模型轮廓裁掉。
        out_color = vec4((base * layer_alpha + glow) * pc.tint.a, a);
        return;
    }

    if (pc.mask.x > 0.5) {
        float mask_value = texture(in_mask, v_mask_uv).r;
        if (pc.mask.y > 0.5) {
            mask_value = 1.0 - mask_value;
        }
        if (mask_value < 0.5) {
            discard;
        }
    }
    vec4 color = pc.fx.x > 0.001 ? sample_blurred(v_uv, pc.fx.x) : texture(in_texture, v_uv);
    if (pc.tint.a < 0.0) {
        // stencil mask pass: only the opaque silhouette writes stencil.
        if (color.a < 0.5) {
            discard;
        }
        out_color = vec4(1.0);
        return;
    }
    color.rgb *= pc.tint.rgb;
    color.rgb *= pc.multiply.rgb;
    color.rgb += pc.screen.rgb * (1.0 - color.rgb);
    color.rgb = (color.rgb - 0.5) * pc.adjust.y + 0.5;
    color.rgb *= pc.adjust.x;
    float luminance = dot(color.rgb, vec3(0.299, 0.587, 0.114));
    color.rgb = mix(vec3(luminance), color.rgb, pc.adjust.z);
    color.rgb = pow(max(color.rgb, vec3(0.0)), vec3(1.0 / max(pc.adjust.w, 0.01)));

    if (pc.fx.y > 0.001) {
        float bright = smoothstep(pc.fx.z, pc.fx.z + 0.2, luminance);
        color.rgb += color.rgb * pc.fx.y * bright * pc.fx.w;
    }
    if (pc.shape.z > 0.001) {
        vec2 half_size = pc.shape.yz * 0.5;
        vec2 point = abs((v_uv - 0.5) * pc.shape.yz) - half_size + vec2(pc.shape.x);
        float distance_value = length(max(point, vec2(0.0)))
            + min(max(point.x, point.y), 0.0) - pc.shape.x;
        color.a *= 1.0 - smoothstep(-0.75, 0.75, distance_value);
    }
    // mode 2: 把单个立绘层画进透明纹理, 输出预乘 alpha, 供整层合成采样。
    if (pc.mask_transform.w > 1.5) {
        float a = color.a * pc.tint.a;
        out_color = vec4(color.rgb * a, a);
        return;
    }
    out_color = vec4(color.rgb, color.a * pc.tint.a);
}
