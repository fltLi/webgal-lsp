        float dx = coord.x - pc.params.y / dimensions.x;
        float dy = (coord.y - pc.params.z / dimensions.y) * pc.params.w;
        float dis = sqrt(dx * dx + dy * dy) + 0.00001;
        d = dy / dis;
    }
    vec3 dir = vec3(d, d, 0.0);
    float noise = turb(dir + vec3(pc.params2.x, 0.0, 62.1 + pc.params2.x) * 0.05,
                       vec3(480.0, 320.0, 480.0), pc.params2.z, pc.params2.y);
    noise = mix(noise, 0.0, 0.3);
    vec4 mist = vec4(noise, noise, noise, 1.0) * (1.0 - coord.y);
    mist.a = 1.0;
    mist *= pc.params2.w;
    return texture(in_texture, v_uv) + mist;
}

/// pixi-filters GlitchFilter. 引擎用 canvas 噪声纹理算位移, 这里按维护者的决定改成
/// hash 噪声: 观感一致、逐像素不同, 但不需要额外资源且天然可复现。
/// 参数: slices/offset/direction/seed, 尺寸 (宽, 高)。
vec4 glitch() {
    vec2 dimensions = pc.params4.xy;
    float slices = max(pc.params.x, 1.0);
    float offset = pc.params.y;
    float direction = pc.params.z;
    float seed = pc.params.w;
    vec2 uv = v_uv;
    // direction 0 = 水平切片, 1 = 垂直切片。
    float axis = direction > 0.5 ? uv.x : uv.y;
    float slice = floor(axis * slices);
    float r = fract(sin(slice * 12.9898 + seed * 78.233) * 43758.5453);
    float shift = (r * 2.0 - 1.0) * offset / dimensions.x;
    if (direction > 0.5) {
        uv.y += shift;
    } else {
        uv.x += shift;
    }
    vec2 texel = 1.0 / vec2(textureSize(in_texture, 0));
    uv = clamp(uv, texel * 0.5, vec2(1.0) - texel * 0.5);
    return texture(in_texture, uv);
}

/// SSAA: 2x2 box 降采样。目标比输入小一半, 每个输出像素对应输入的 4 个像素。
vec4 downsample() {
    vec2 texel = 1.0 / vec2(textureSize(in_texture, 0));
    vec4 color = texture(in_texture, v_uv + texel * vec2(-0.5, -0.5));
    color += texture(in_texture, v_uv + texel * vec2(0.5, -0.5));
    color += texture(in_texture, v_uv + texel * vec2(-0.5, 0.5));
    color += texture(in_texture, v_uv + texel * vec2(0.5, 0.5));
    return color * 0.25;
}

// ---------------------------------------------------------------------------
// SMAA 1x Medium (three.js `SMAAShader.js` 的移植, 参考 iRyoku SMAA v2.8)。
// 三个 pass 分别在帧收尾时跑: 边缘检测 -> 混合权重 -> 邻域混合。
// 注意三点空间差异: 我们的 uv 是 y 向下、混合发生在编码空间 (不做 2.2 次幂往返)。
// ---------------------------------------------------------------------------

const float kSmaaThreshold = 0.1;
const int kSmaaMaxSearchSteps = 8;
const float kSmaaAreaMaxDistance = 16.0;
const vec2 kSmaaAreaPixelSize = vec2(1.0 / 160.0, 1.0 / 560.0);
const float kSmaaAreaSubtexSize = 1.0 / 7.0;

float max_component(vec3 value) {
    return max(max(value.r, value.g), value.b);
}

/// pass 1: 色彩边缘检测。R = 水平方向有边 (西侧), G = 垂直方向有边 (北侧)。
vec4 smaa_edges() {
    vec2 res = pc.params.xy;
    vec3 center = texture(in_texture, v_uv).rgb;

    vec3 left = texture(in_texture, v_uv + vec2(-res.x, 0.0)).rgb;
    vec3 top = texture(in_texture, v_uv + vec2(0.0, -res.y)).rgb;

    vec4 delta;
    delta.x = max_component(abs(center - left));
    delta.y = max_component(abs(center - top));

    vec2 edges = step(vec2(kSmaaThreshold), delta.xy);
    if (edges.x + edges.y == 0.0) {
        return vec4(0.0);
    }

    vec3 right = texture(in_texture, v_uv + vec2(res.x, 0.0)).rgb;
    vec3 bottom = texture(in_texture, v_uv + vec2(0.0, res.y)).rgb;
    delta.z = max_component(abs(center - right));
    delta.w = max_component(abs(center - bottom));

    float max_delta = max(max(delta.x, delta.y), max(delta.z, delta.w));

    // 再往左/上多看一格, 压掉细碎纹理上的伪边缘 (与参考实现一致: 覆盖 z/w)。
    vec3 left_left = texture(in_texture, v_uv + vec2(-2.0 * res.x, 0.0)).rgb;
    vec3 top_top = texture(in_texture, v_uv + vec2(0.0, -2.0 * res.y)).rgb;
    delta.z = max_component(abs(center - left_left));
    delta.w = max_component(abs(center - top_top));
    max_delta = max(max_delta, max(delta.z, delta.w));

    edges *= step(0.5 * max_delta, delta.xy);
    return vec4(edges, 0.0, 0.0);
}

float smaa_search_length(vec2 e, float bias, float scale) {
    e.x = bias + e.x * scale;
    return 255.0 * texture(smaa_search, e).r;
}

vec2 smaa_area_lookup(vec2 dist, float e1, float e2, float offset) {
    vec2 texcoord = kSmaaAreaMaxDistance * round(4.0 * vec2(e1, e2)) + dist;
    texcoord = kSmaaAreaPixelSize * texcoord + 0.5 * kSmaaAreaPixelSize;
    texcoord.y += kSmaaAreaSubtexSize * offset;
    return texture(smaa_area, texcoord).rg;
}

float smaa_search_x_left(vec2 texcoord, float end, vec2 res) {
    vec2 e = vec2(0.0, 1.0);
    for (int i = 0; i < kSmaaMaxSearchSteps; ++i) {
        e = texture(in_texture, texcoord).rg;
        texcoord -= vec2(2.0, 0.0) * res;
        if (!(texcoord.x > end && e.g > 0.8281 && e.r == 0.0)) {
            break;
        }
    }
    texcoord.x += 0.25 * res.x;
    texcoord.x += res.x;
    texcoord.x += 2.0 * res.x;
    texcoord.x -= res.x * smaa_search_length(e, 0.0, 0.5);
    return texcoord.x;
}

float smaa_search_x_right(vec2 texcoord, float end, vec2 res) {
    vec2 e = vec2(0.0, 1.0);
    for (int i = 0; i < kSmaaMaxSearchSteps; ++i) {
        e = texture(in_texture, texcoord).rg;
        texcoord += vec2(2.0, 0.0) * res;
        if (!(texcoord.x < end && e.g > 0.8281 && e.r == 0.0)) {
            break;
        }
    }
    texcoord.x -= 0.25 * res.x;
    texcoord.x -= res.x;
    texcoord.x -= 2.0 * res.x;
    texcoord.x += res.x * smaa_search_length(e, 0.5, 0.5);
    return texcoord.x;
}

float smaa_search_y_up(vec2 texcoord, float end, vec2 res) {
    vec2 e = vec2(1.0, 0.0);
    for (int i = 0; i < kSmaaMaxSearchSteps; ++i) {
        e = texture(in_texture, texcoord).rg;
        texcoord -= vec2(0.0, 2.0) * res;
        if (!(texcoord.y > end && e.r > 0.8281 && e.g == 0.0)) {
            break;
        }
    }
    texcoord.y += 0.25 * res.y;
    texcoord.y += res.y;
    texcoord.y += 2.0 * res.y;
    texcoord.y -= res.y * smaa_search_length(e.gr, 0.0, 0.5);
    return texcoord.y;
}

float smaa_search_y_down(vec2 texcoord, float end, vec2 res) {
    vec2 e = vec2(1.0, 0.0);
    for (int i = 0; i < kSmaaMaxSearchSteps; ++i) {
        e = texture(in_texture, texcoord).rg;
        texcoord += vec2(0.0, 2.0) * res;
        if (!(texcoord.y < end && e.r > 0.8281 && e.g == 0.0)) {
            break;
        }
    }
    texcoord.y -= 0.25 * res.y;
    texcoord.y -= res.y;
    texcoord.y -= 2.0 * res.y;
    texcoord.y += res.y * smaa_search_length(e.gr, 0.5, 0.5);
    return texcoord.y;
}

/// pass 2: 混合权重。in_texture 是边缘图, 输出 RG = 南北, BA = 东西。
vec4 smaa_weights() {
    vec2 res = pc.params.xy;
    vec2 pixcoord = v_uv / res;
    // 与参考 GLSL 的 @PSEUDO_GATHER4 偏移一致 (y 向下)。
    // 偏移符号按「我们的 uv y 向下」验过: 边缘检测的 north 在 -y 侧, gather/搜索在 +y 侧。
    vec4 offset0 = v_uv.xyxy + res.xyxy * vec4(-0.25, 0.125, 1.25, 0.125);
    vec4 offset1 = v_uv.xyxy + res.xyxy * vec4(-0.125, -0.25, -0.125, -1.25);
    vec4 offset2 = vec4(offset0.xz, offset1.yw) +
                   res.xxyy * vec4(-2.0, -2.0, -2.0, -2.0) * float(kSmaaMaxSearchSteps);

    vec4 weights = vec4(0.0);
    vec2 e = texture(in_texture, v_uv).rg;

    if (e.g > 0.0) {
        vec2 coords;
        coords.x = smaa_search_x_left(offset0.xy, offset2.x, res);
        coords.y = offset1.y;
        vec2 d;
        d.x = coords.x;
        float e1 = texture(in_texture, coords).r;

        coords.x = smaa_search_x_right(offset0.zw, offset2.y, res);
        d.y = coords.x;
        d = d / res.x - pixcoord.x;
        vec2 sqrt_d = sqrt(abs(d));

        coords.y += res.y;
        float e2 = texture(in_texture, coords + vec2(res.x, 0.0)).r;
        weights.rg = smaa_area_lookup(sqrt_d, e1, e2, 0.0);
    }

    if (e.r > 0.0) {
        vec2 coords;
        coords.y = smaa_search_y_up(offset1.xy, offset2.z, res);
        coords.x = offset0.x;
        vec2 d;
        d.x = coords.y;
        float e1 = texture(in_texture, coords).g;

        coords.y = smaa_search_y_down(offset1.zw, offset2.w, res);
        d.y = coords.y;
        d = d / res.y - pixcoord.y;
        vec2 sqrt_d = sqrt(abs(d));

        coords.y += res.y;
        float e2 = texture(in_texture, coords + vec2(0.0, -res.y)).g;
        weights.ba = smaa_area_lookup(sqrt_d, e1, e2, 0.0);
    }

    return weights;
}

/// pass 3: 邻域混合。in_texture 是原图, in_second 是权重图。
vec4 smaa_blend() {
    vec2 res = pc.params.xy;
    vec4 a;
    a.xz = texture(in_second, v_uv).xz;
    a.y = texture(in_second, v_uv + vec2(0.0, res.y)).g;
    a.w = texture(in_second, v_uv + vec2(res.x, 0.0)).a;

    if (dot(a, vec4(1.0)) < 1e-5) {
        return texture(in_texture, v_uv);
    }

    vec2 offset;
    offset.x = a.a > a.b ? a.a : -a.b;
    offset.y = a.g > a.r ? -a.g : a.r;
    if (abs(offset.x) > abs(offset.y)) {
        offset.y = 0.0;
    } else {
        offset.x = 0.0;
    }

    vec4 color = texture(in_texture, v_uv);
    vec4 opposite = texture(in_texture, v_uv + sign(offset) * res);
    float blend = abs(offset.x) > abs(offset.y) ? abs(offset.x) : abs(offset.y);
    // 我们的整条链路都在编码空间里混合, 所以这里不做 2.2 次幂往返 (three.js 是因为它在线性空间)。
    return mix(color, opposite, blend);
}

void main() {
    if (kKind == 0) {
        out_color = adjustment();
    } else if (kKind == 1) {
        out_color = blur();
    } else if (kKind == 2) {
        out_color = extract();
    } else if (kKind == 3) {
        out_color = kawase();
    } else if (kKind == 4) {
        out_color = bloom();
    } else if (kKind == 5) {
        out_color = bevel();
    } else if (kKind == 6) {
        // params.x 是混回原图的比例; pixi 的 FXAAFilter 等效于 1.0, 这里也默认 1.0。
        out_color = vec4(fxaa(in_texture, v_uv), 1.0);
    } else if (kKind == 7) {
        // Composite: 预乘结果乘层 alpha, 由 ONE / ONE_MINUS_SRC_ALPHA 混回舞台。
        vec4 color = texture(in_texture, v_uv);
        float alpha = pc.params.x;
        out_color = vec4(color.rgb * alpha, color.a * alpha);
    } else if (kKind == 8) {
        out_color = downsample();
    } else if (kKind == 9) {
        out_color = old_film();
    } else if (kKind == 10) {
        out_color = dot_film();
    } else if (kKind == 11) {
        out_color = rgb_split();
    } else if (kKind == 12) {
        out_color = reflection();
    } else if (kKind == 13) {
        out_color = radius_alpha();
    } else if (kKind == 14) {
        out_color = shockwave();
    } else if (kKind == 15) {
        out_color = godray();
    } else if (kKind == 16) {
        out_color = glitch();
    } else if (kKind == 17) {
        out_color = smaa_edges();
    } else if (kKind == 18) {
        out_color = smaa_weights();
    } else if (kKind == 19) {
        out_color = smaa_blend();
    } else {
        out_color = vec4(0.0);
    }
}
