{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebGAL Ink",
  "version": "0.2.0",
  "identifier": "com.fltli.webgalink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WebGAL Ink",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "WebGAL Ink",
        "width": 420,
        "height": 280,
        "resizable": false,
        "center": true,
        "decorations": false,
        "url": "splash.html",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MPL-2.0-only",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}