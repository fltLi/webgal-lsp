{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebGAL Ink",
  "version": "../package.json",
  "identifier": "com.fltli.webgalink",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WebGAL Ink",
        "width": 900,
        "height": 620,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#fafafa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MPL-2.0-only",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
