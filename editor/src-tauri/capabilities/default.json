{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": ["**/*"]
    },
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-write-file",
    "fs:allow-watch",
    "fs:allow-unwatch"
  ]
}
