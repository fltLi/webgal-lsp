{
  "name": "webgal-ink",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext .ts,.svelte && npm run lint:css && npm run lint:dynamic-classes",
    "lint:css": "node scripts/check-css-classes.mjs",
    "lint:dynamic-classes": "node scripts/check-dynamic-classes.mjs",
    "type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run type-check:tests",
    "type-check:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:desktop": "npm install && npm run tauri dev"
  },
  "dependencies": {
    "@fluentui/svg-icons": "^1.1.344",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "bits-ui": "^2.19.5",
    "marked": "^15.0.12",
    "marked-alert": "^2.1.2",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  }
}
