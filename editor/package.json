{
  "name": "webgal-ink",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext .ts,.svelte && bun run lint:css && bun run lint:dynamic-classes",
    "lint:css": "node scripts/check-css-classes.mjs",
    "lint:dynamic-classes": "node scripts/check-dynamic-classes.mjs",
    "type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun run type-check:tests",
    "type-check:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --plugin=prettier-plugin-svelte --write \"src/**/*.{ts,svelte,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,js,cjs,mjs,ts}\"",
    "format-check": "prettier --plugin=prettier-plugin-svelte --check \"src/**/*.{ts,svelte,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,js,cjs,mjs,ts}\"",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:desktop": "bun install && bun run tauri dev"
  },
  "dependencies": {
    "@fluentui/svg-icons": "^1.1.344",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "bits-ui": "^2.19.5",
    "marked": "^15.0.12",
    "marked-alert": "^2.1.2",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "^20.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16",
    "vitest": "^3.2.7"
  }
}
