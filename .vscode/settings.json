{
  // Rust
  "rust-analyzer.check.command": "clippy",
  // Svelte
  "files.exclude": {
    "**/.svelte-kit": true
  },
  "search.exclude": {
    "**/.svelte-kit": true
  },
  // Python
  "python.analysis.typeCheckingMode": "strict",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  // CMake
  "cmake.sourceDirectory": "${workspaceFolder}"
}
