{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Parse Playground",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/packages/webgal-parse-playground",
            "preLaunchTask": "launch:playground",
            "runtimeArgs": [
                "--disable-web-security"
            ],
            "sourceMapPathOverrides": {
                "webpack:///./*": "${webRoot}/*"
            }
        },
        {
            "name": "Launch VSCode Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/packages/webgal-vscode-extension"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/webgal-vscode-extension/dist/**/*.js"
            ],
            "preLaunchTask": "build:extension",
            "env": {
                "SERVER_PATH": "${workspaceFolder}/target/debug/webgal-language-server.exe"
            }
        },
        {
            "name": "Launch Ink Editor",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "bun",
            "runtimeArgs": [
                "run",
                "dev:desktop"
            ],
            "cwd": "${workspaceFolder}/editor",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}