{
  "name": "webgal-novel-preprocess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebGAL 小说文本预处理核心: 将无格式小说文本转换为原始 WebGAL 脚本的纯逻辑库",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src tests --ext .ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,js,cjs,mjs,ts}\"",
    "format-check": "prettier --check \"src/**/*.ts\" \"*.{json,js,cjs,mjs,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
