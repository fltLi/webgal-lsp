{
  "name": "webgal-vscode-extension",
  "displayName": "WebGAL Language Support (Dev)",
  "description": "Language server for WebGAL scenario files (development only)",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "webgal",
        "aliases": [
          "WebGAL",
          "webgal"
        ],
        "extensions": [
          ".txt"
        ],
        "filenamePatterns": [
          "**/scene/**/*.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "WebGAL Language Server",
      "properties": {
        "webgal-language-server.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,js,cjs,mjs,ts}\"",
    "format-check": "prettier --check \"src/**/*.ts\" \"*.{json,js,cjs,mjs,ts}\"",
    "compile": "tsc",
    "watch": "tsc --watch",
    "build": "bun run compile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  }
}
