{
  "name": "webgal-parse-playground",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "build:wasm": "cd ../../crates/webgal-language-service && wasm-pack build --target web --release",
    "build:wasm:dev": "cd ../../crates/webgal-language-service && wasm-pack build --target web",
    "dev": "vite",
    "build": "npm run build:wasm && tsc && vite build",
    "build:dev": "npm run build:wasm:dev && tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-languageserver-types": "^3.18.0",
    "webgal-language-service": "file:../../crates/webgal-language-service/pkg"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "monaco-editor": "^0.34.1",
    "vite": "^8.2.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.3",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
