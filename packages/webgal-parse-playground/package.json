{
  "name": "webgal-parse-playground",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,js,cjs,mjs,ts}\"",
    "format-check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,js,cjs,mjs,ts}\"",
    "build:wasm": "cd ../../crates/webgal-language-service && wasm-pack build --target web --release -- --features simulate-diagnose",
    "build:wasm:dev": "cd ../../crates/webgal-language-service && wasm-pack build --target web -- --features simulate-diagnose",
    "dev": "vite",
    "build": "bun run build:wasm && tsc && vite build",
    "build:dev": "bun run build:wasm:dev && tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-languageserver-types": "^3.18.0",
    "webgal-language-service": "file:../../crates/webgal-language-service/pkg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "monaco-editor": "^0.34.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.3",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
