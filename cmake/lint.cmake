# This file is generated by AI.

# 格式与静态检查目标。本文件由根 CMakeLists.txt include, 因此
# CMAKE_CURRENT_SOURCE_DIR 指向 workspace 根目录。

set(WEBGAL_NATIVE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/native")

find_program(WEBGAL_CLANG_FORMAT NAMES clang-format clang-format.exe)
find_program(WEBGAL_CLANG_TIDY NAMES clang-tidy clang-tidy.exe)

file(GLOB_RECURSE WEBGAL_CXX_SOURCES CONFIGURE_DEPENDS
    "${WEBGAL_NATIVE_ROOT}/*/src/*.cpp"
    "${WEBGAL_NATIVE_ROOT}/*/src/*.hpp"
    "${WEBGAL_NATIVE_ROOT}/*/include/*.h"
    "${WEBGAL_NATIVE_ROOT}/*/tests/*.cpp"
    "${WEBGAL_NATIVE_ROOT}/*/tests/*.hpp"
)

if(WEBGAL_CLANG_FORMAT)
    add_custom_target(format-check
        COMMAND "${WEBGAL_CLANG_FORMAT}" --dry-run --Werror ${WEBGAL_CXX_SOURCES}
        COMMENT "clang-format check"
        VERBATIM
    )
    add_custom_target(format
        COMMAND "${WEBGAL_CLANG_FORMAT}" -i ${WEBGAL_CXX_SOURCES}
        COMMENT "clang-format"
        VERBATIM
    )
else()
    message(STATUS "clang-format not found; format targets disabled")
endif()

if(WEBGAL_CLANG_TIDY)
    # 直接调 clang-tidy, 不依赖 run-clang-tidy: 后者在 Windows 上是个无扩展名的
    # Python 脚本, cmd 无法直接执行。只传编译数据库里真的存在的 .cpp。
    file(GLOB_RECURSE WEBGAL_TIDY_SOURCES CONFIGURE_DEPENDS
        "${WEBGAL_NATIVE_ROOT}/*/src/*.cpp"
        "${WEBGAL_NATIVE_ROOT}/*/tests/*.cpp"
    )
    # stb_vorbis 是按 C++ 编译的第三方 C 实现, 不参与本仓库的检查规则。
    list(FILTER WEBGAL_TIDY_SOURCES EXCLUDE REGEX "stb_vorbis_impl\\.cpp$")

    add_custom_target(tidy
        COMMAND "${WEBGAL_CLANG_TIDY}" -p "${CMAKE_BINARY_DIR}"
                --header-filter "${WEBGAL_NATIVE_ROOT}/[^/]+/(src|include)"
                # ci preset 带 /WX, 会把编译告警升级成 error 让 tidy 直接失败;
                # tidy 只报告问题, 是否阻塞由 .clang-tidy 的 WarningsAsErrors 决定。
                --extra-arg=-Wno-error
                ${WEBGAL_TIDY_SOURCES}
        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
        COMMENT "clang-tidy"
        VERBATIM
    )
else()
    message(STATUS "clang-tidy not found; tidy target disabled")
endif()
