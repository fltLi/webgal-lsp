# This file is generated by AI.

# 通过环境变量或 PATH 找到 vcpkg, 再交给官方 toolchain.
# 这样 CMakePresets 不写死本机路径, 也不需要用户额外设置 VCPKG_ROOT.

if(NOT DEFINED VCPKG_ROOT OR VCPKG_ROOT STREQUAL "")
    if(DEFINED ENV{VCPKG_ROOT} AND NOT "$ENV{VCPKG_ROOT}" STREQUAL "")
        set(VCPKG_ROOT "$ENV{VCPKG_ROOT}")
    elseif(DEFINED ENV{VCPKG_INSTALLATION_ROOT} AND NOT "$ENV{VCPKG_INSTALLATION_ROOT}" STREQUAL "")
        set(VCPKG_ROOT "$ENV{VCPKG_INSTALLATION_ROOT}")
    else()
        find_program(WEBGAL_VCPKG_EXECUTABLE NAMES vcpkg)
        if(WEBGAL_VCPKG_EXECUTABLE)
            get_filename_component(VCPKG_ROOT "${WEBGAL_VCPKG_EXECUTABLE}" DIRECTORY)
        endif()
    endif()
endif()

if(NOT VCPKG_ROOT OR NOT EXISTS "${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
    message(FATAL_ERROR
        "找不到 vcpkg. 请把 vcpkg 加入 PATH, 或设置 VCPKG_ROOT 指向 vcpkg 根目录.")
endif()

set(VCPKG_ROOT "${VCPKG_ROOT}" CACHE PATH "vcpkg root")
include("${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
